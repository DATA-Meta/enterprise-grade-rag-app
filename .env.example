# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM Provider ---
OPENAI_API_KEY=

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM Gateway (Portkey) ---
PORTKEY_API_KEY=

# --- Guardrails (NVIDIA NeMo / AI Endpoints) ---
NVIDIA_API_KEY=

# --- Observability ---
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Postgres (LangGraph checkpointing) ---
POSTGRES_URL=postgresql://user:password@localhost:5432/ragdb

# --- Redis (rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
JINA_API_KEY=